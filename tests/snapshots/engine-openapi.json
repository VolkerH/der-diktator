{
  "openapi": "3.1.0",
  "info": {
    "title": "Diktator model service",
    "version": "0.1.0"
  },
  "paths": {
    "/recording-policy": {
      "get": {
        "summary": "Recording Policy",
        "operationId": "recording_policy_recording_policy_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RecordingPolicy"
                }
              }
            }
          }
        }
      }
    },
    "/models": {
      "get": {
        "summary": "Models",
        "operationId": "models_models_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ModelsStatus"
                }
              }
            }
          }
        }
      }
    },
    "/health": {
      "get": {
        "summary": "Health",
        "operationId": "health_health_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": {
                    "anyOf": [
                      {
                        "type": "string"
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "type": "object",
                  "title": "Response Health Health Get"
                }
              }
            }
          }
        }
      }
    },
    "/models/{model_id}/download": {
      "post": {
        "summary": "Download",
        "operationId": "download_models__model_id__download_post",
        "parameters": [
          {
            "name": "model_id",
            "in": "path",
            "required": true,
            "schema": {
              "enum": [
                "phonon-2",
                "parakeet-v3",
                "whisper-large-v3-turbo"
              ],
              "type": "string",
              "title": "Model Id"
            }
          }
        ],
        "responses": {
          "202": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ModelsStatus"
                }
              }
            }
          },
          "409": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            },
            "description": "Conflict"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            },
            "description": "Unprocessable Entity"
          }
        }
      }
    },
    "/models/{model_id}/activate": {
      "post": {
        "summary": "Activate",
        "operationId": "activate_models__model_id__activate_post",
        "parameters": [
          {
            "name": "model_id",
            "in": "path",
            "required": true,
            "schema": {
              "enum": [
                "phonon-2",
                "parakeet-v3",
                "whisper-large-v3-turbo"
              ],
              "type": "string",
              "title": "Model Id"
            }
          }
        ],
        "responses": {
          "202": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ModelsStatus"
                }
              }
            }
          },
          "409": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            },
            "description": "Conflict"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            },
            "description": "Unprocessable Entity"
          }
        }
      }
    },
    "/models/{model_id}/delete": {
      "post": {
        "summary": "Delete",
        "operationId": "delete_models__model_id__delete_post",
        "parameters": [
          {
            "name": "model_id",
            "in": "path",
            "required": true,
            "schema": {
              "enum": [
                "phonon-2",
                "parakeet-v3",
                "whisper-large-v3-turbo"
              ],
              "type": "string",
              "title": "Model Id"
            }
          }
        ],
        "responses": {
          "202": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ModelsStatus"
                }
              }
            }
          },
          "409": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            },
            "description": "Conflict"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            },
            "description": "Unprocessable Entity"
          }
        }
      }
    },
    "/transcribe": {
      "post": {
        "summary": "Transcribe",
        "operationId": "transcribe_transcribe_post",
        "parameters": [
          {
            "name": "model",
            "in": "query",
            "required": true,
            "schema": {
              "enum": [
                "phonon-2",
                "parakeet-v3",
                "whisper-large-v3-turbo"
              ],
              "type": "string",
              "title": "Model"
            }
          },
          {
            "name": "x-recording-policy-revision",
            "in": "header",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "X-Recording-Policy-Revision"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Transcription"
                }
              }
            }
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            },
            "description": "Bad Request"
          },
          "408": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            },
            "description": "Request Timeout"
          },
          "409": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            },
            "description": "Conflict"
          },
          "413": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            },
            "description": "Request Entity Too Large"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            },
            "description": "Unprocessable Entity"
          },
          "502": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            },
            "description": "Bad Gateway"
          },
          "503": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            },
            "description": "Service Unavailable"
          },
          "504": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            },
            "description": "Gateway Timeout"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "ApiError": {
        "properties": {
          "detail": {
            "type": "string",
            "title": "Detail"
          },
          "code": {
            "type": "string",
            "title": "Code"
          },
          "context": {
            "anyOf": [
              {
                "additionalProperties": true,
                "type": "object"
              },
              {
                "type": "null"
              }
            ],
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "detail",
          "code"
        ],
        "title": "ApiError",
        "description": "An actionable public failure; context never contains internal diagnostics."
      },
      "ClientDeadlines": {
        "properties": {
          "upload": {
            "type": "integer",
            "title": "Upload"
          },
          "batch": {
            "type": "integer",
            "title": "Batch"
          },
          "live": {
            "type": "integer",
            "title": "Live"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": ["upload", "batch", "live"],
        "title": "ClientDeadlines",
        "description": "Backend-derived maximum client waits in integer milliseconds."
      },
      "ModelStatus": {
        "properties": {
          "id": {
            "type": "string",
            "enum": [
              "phonon-2",
              "parakeet-v3",
              "whisper-large-v3-turbo"
            ],
            "title": "Id"
          },
          "name": {
            "type": "string",
            "title": "Name"
          },
          "languages": {
            "type": "string",
            "title": "Languages"
          },
          "language_labels": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Language Labels"
          },
          "download_mb": {
            "type": "integer",
            "title": "Download Mb"
          },
          "live": {
            "type": "boolean",
            "title": "Live"
          },
          "license": {
            "type": "string",
            "title": "License",
            "default": "CC-BY-4.0"
          },
          "source": {
            "type": "string",
            "title": "Source"
          },
          "installed": {
            "type": "boolean",
            "title": "Installed"
          },
          "state": {
            "type": "string",
            "enum": [
              "missing",
              "installed",
              "downloading",
              "loading",
              "deleting",
              "ready",
              "error"
            ],
            "title": "State"
          },
          "message": {
            "type": "string",
            "title": "Message",
            "default": ""
          }
        },
        "type": "object",
        "required": [
          "id",
          "name",
          "languages",
          "language_labels",
          "download_mb",
          "live",
          "source",
          "installed",
          "state"
        ],
        "title": "ModelStatus"
      },
      "ModelsStatus": {
        "properties": {
          "active": {
            "anyOf": [
              {
                "type": "string",
                "enum": [
                  "phonon-2",
                  "parakeet-v3",
                  "whisper-large-v3-turbo"
                ]
              },
              {
                "type": "null"
              }
            ],
            "title": "Active"
          },
          "preferred": {
            "type": "string",
            "enum": [
              "phonon-2",
              "parakeet-v3",
              "whisper-large-v3-turbo"
            ],
            "title": "Preferred",
            "default": "phonon-2"
          },
          "busy": {
            "type": "boolean",
            "title": "Busy"
          },
          "models": {
            "items": {
              "$ref": "#/components/schemas/ModelStatus"
            },
            "type": "array",
            "title": "Models"
          }
        },
        "type": "object",
        "required": [
          "active",
          "busy",
          "models"
        ],
        "title": "ModelsStatus"
      },
      "RecordingPolicy": {
        "properties": {
          "protocol_version": {
            "type": "integer",
            "const": 1,
            "title": "Protocol Version",
            "default": 1
          },
          "hard_limit_seconds": {
            "type": "integer",
            "title": "Hard Limit Seconds",
            "default": 3600
          },
          "wav_container_allowance_bytes": {
            "type": "integer",
            "title": "Wav Container Allowance Bytes",
            "default": 800044
          },
          "max_stream_frame_bytes": {
            "type": "integer",
            "title": "Max Stream Frame Bytes",
            "default": 65536
          },
          "upload_timeout_seconds": {
            "type": "number",
            "title": "Upload Timeout Seconds",
            "default": 180.0
          },
          "batch_timeout_seconds": {
            "type": "number",
            "title": "Batch Timeout Seconds",
            "default": 180.0
          },
          "live_finalization_timeout_seconds": {
            "type": "number",
            "title": "Live Finalization Timeout Seconds",
            "default": 180.0
          },
          "client_timeout_margin_seconds": {
            "type": "number",
            "title": "Client Timeout Margin Seconds",
            "default": 10.0
          },
          "client_deadlines_ms": {
            "$ref": "#/components/schemas/ClientDeadlines",
            "readOnly": true
          },
          "max_pcm_bytes": {
            "type": "integer",
            "title": "Max Pcm Bytes",
            "readOnly": true
          },
          "max_audio_bytes": {
            "type": "integer",
            "title": "Max Audio Bytes",
            "readOnly": true
          },
          "policy_revision": {
            "type": "string",
            "title": "Policy Revision",
            "readOnly": true
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "max_pcm_bytes",
          "max_audio_bytes",
          "policy_revision"
        ],
        "title": "RecordingPolicy",
        "description": "Enforcement and waiting budgets; changing these requires a process restart."
      },
      "Transcription": {
        "properties": {
          "text": {
            "type": "string",
            "title": "Text"
          }
        },
        "type": "object",
        "required": [
          "text"
        ],
        "title": "Transcription",
        "description": "The transcript returned to the browser."
      }
    }
  }
}
