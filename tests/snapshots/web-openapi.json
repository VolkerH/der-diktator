  "components": {
    "schemas": {
      "ApiError": {
        "properties": {
          "detail": {
            "type": "string",
            "title": "Detail"
          },
          "code": {
            "type": "string",
            "title": "Code"
          },
          "context": {
            "anyOf": [
              {
                "additionalProperties": true,
                "type": "object"
              },
              {
                "type": "null"
              }
            ],
            "title": "Context"
          }
        },
        "type": "object",
        "required": ["detail", "code"],
        "title": "ApiError",
        "description": "An actionable public failure; context never contains internal diagnostics."
      },
      "Chat": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id"
          },
          "created": {
            "type": "string",
            "format": "date-time",
            "title": "Created"
          },
          "updated": {
            "type": "string",
            "format": "date-time",
            "title": "Updated"
          },
          "text": {
            "type": "string",
            "title": "Text",
            "default": ""
          },
          "recordings": {
            "items": {
              "$ref": "#/components/schemas/Recording"
            },
            "type": "array",
            "title": "Recordings",
            "default": []
          }
        },
        "type": "object",
        "required": ["id", "created", "updated"],
        "title": "Chat",
        "description": "One editable transcript and every recording made for it."
      },
      "ChatSummary": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id"
          },
          "title": {
            "type": "string",
            "title": "Title"
          },
          "updated": {
            "type": "string",
            "format": "date-time",
            "title": "Updated"
          },
          "recording_count": {
            "type": "integer",
            "title": "Recording Count"
          }
        },
        "type": "object",
        "required": ["id", "title", "updated", "recording_count"],
        "title": "ChatSummary",
        "description": "What the chat list needs, without transcripts or recordings."
      },
      "ModelStatus": {
        "properties": {
          "id": {
            "type": "string",
            "enum": ["phonon-2", "parakeet-v3", "whisper-large-v3-turbo"],
            "title": "Id"
          },
          "name": {
            "type": "string",
            "title": "Name"
          },
          "languages": {
            "type": "string",
            "title": "Languages"
          },
          "language_labels": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Language Labels"
          },
          "download_mb": {
            "type": "integer",
            "title": "Download Mb"
          },
          "live": {
            "type": "boolean",
            "title": "Live"
          },
          "license": {
            "type": "string",
            "title": "License",
            "default": "CC-BY-4.0"
          },
          "source": {
            "type": "string",
            "title": "Source"
          },
          "installed": {
            "type": "boolean",
            "title": "Installed"
          },
          "state": {
            "type": "string",
            "enum": [
              "missing",
              "installed",
              "downloading",
              "loading",
              "deleting",
              "ready",
              "error"
            ],
            "title": "State"
          },
          "message": {
            "type": "string",
            "title": "Message",
            "default": ""
          }
        },
        "type": "object",
        "required": [
          "id",
          "name",
          "languages",
          "language_labels",
          "download_mb",
          "live",
          "source",
          "installed",
          "state"
        ],
        "title": "ModelStatus"
      },
      "ModelsStatus": {
        "properties": {
          "active": {
            "anyOf": [
              {
                "type": "string",
                "enum": ["phonon-2", "parakeet-v3", "whisper-large-v3-turbo"]
              },
              {
                "type": "null"
              }
            ],
            "title": "Active"
          },
          "preferred": {
            "type": "string",
            "enum": ["phonon-2", "parakeet-v3", "whisper-large-v3-turbo"],
            "title": "Preferred",
            "default": "phonon-2"
          },
          "busy": {
            "type": "boolean",
            "title": "Busy"
          },
          "models": {
            "items": {
              "$ref": "#/components/schemas/ModelStatus"
            },
            "type": "array",
            "title": "Models"
          }
        },
        "type": "object",
        "required": ["active", "busy", "models"],
        "title": "ModelsStatus"
      },
      "Recording": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id"
          },
          "created": {
            "type": "string",
            "format": "date-time",
            "title": "Created"
          },
          "duration_seconds": {
            "type": "number",
            "title": "Duration Seconds"
          }
        },
        "type": "object",
        "required": ["id", "created", "duration_seconds"],
        "title": "Recording",
        "description": "A stored recording; its audio lives next to the chat document."
      },
      "TextUpdate": {
        "properties": {
          "text": {
            "type": "string",
            "maxLength": 1000000,
            "title": "Text"
          }
        },
        "type": "object",
        "required": ["text"],
        "title": "TextUpdate"
      },
      "Transcription": {
        "properties": {
          "text": {
            "type": "string",
            "title": "Text"
          }
        },
        "type": "object",
        "required": ["text"],
        "title": "Transcription",
        "description": "The transcript returned to the browser."
      }
    }
  }
}
