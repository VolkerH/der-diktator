{
  "name": "der-diktator-frontend",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "node --test --test-isolation=none frontend/tests/*.test.js",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm test"
  },
  "devDependencies": {
    "eslint": "10.10.0",
    "globals": "17.12.0",
    "prettier": "3.9.5",
    "typescript": "6.0.3"
  }
}
